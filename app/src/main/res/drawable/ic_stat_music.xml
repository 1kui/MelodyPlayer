        android:pathData="M12,5 a1.1,1.1 0 0 1 1.1,1.1 v11.8 a1.1,1.1 0 0 1 -1.1,1.1 a1.1,1.1 0 0 1 -1.1,-1.1 v-11.8 a1.1,1.1 0 0 1 1.1,-1.1 Z" />

