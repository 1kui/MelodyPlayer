        android:pathData="M8.3,7.05 a1.1,1.1 0 0 1 1.1,1.1 v7.7 a1.1,1.1 0 0 1 -1.1,1.1 a1.1,1.1 0 0 1 -1.1,-1.1 v-7.7 a1.1,1.1 0 0 1 1.1,-1.1 Z" />

    <path
